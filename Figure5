import sctour as sct
import scanpy as sc
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
cDCs_Immunecells_filtered = sc.read("data/cDCs_Immunecells_filtered.h5ad")

sc.pp.calculate_qc_metrics(cDCs_Immunecells_filtered, percent_top=None, log1p=False, inplace=True)
sc.pp.highly_variable_genes(cDCs_Immunecells_filtered, subset=True)
cDCs_Immunecells_filtered.X = cDCs_Immunecells_filtered.X.astype('float32') # convert data to float32 type
tnode = sct.train.Trainer(cDCs_Immunecells_filtered, loss_mode='mse')
tnode.train()
cDCs_Immunecells_filtered.obs['ptime'] = tnode.get_time()
#zs represents the latent z from variational inference, and pred_zs represents the latent z from ODE solver
#mix_zs represents the weighted combination of the two, which is used for downstream analysis
mix_zs, zs, pred_zs = tnode.get_latentsp(alpha_z=0.5, alpha_predz=0.5)
cDCs_Immunecells_filtered.obsm['X_TNODE'] = mix_zs

cDCs_Immunecells_filtered.obsm['X_VF'] = tnode.get_vector_field(cDCs_Immunecells_filtered.obs['ptime'].values, cDCs_Immunecells_filtered.obsm['X_TNODE'])
cDCs_Immunecells_filtered = cDCs_Immunecells_filtered[np.argsort(cDCs_Immunecells_filtered.obs['ptime'].values), :]
fig, axs = plt.subplots(ncols=2, nrows=2, figsize=(10, 10))
sc.pl.umap(cDCs_Immunecells_filtered, color='leiden', ax=axs[0, 0], legend_loc='on data', show=False, frameon=False)
sc.pl.umap(cDCs_Immunecells_filtered, color='cluster07', ax=axs[0, 1], legend_loc='on data', show=False, frameon=False)
sc.pl.umap(cDCs_Immunecells_filtered, color='ptime', ax=axs[1, 0], show=False, frameon=False)
sct.vf.plot_vector_field(cDCs_Immunecells_filtered, zs_key='X_TNODE', vf_key='X_VF', use_rep_neigh='X_TNODE', color='cluster07', show=False, ax=axs[1, 1], legend_loc='none', frameon=False, size=100, alpha=0.2)
plt.show()
