# set STIM as class 0, CTRL as class 1, to make categorical
pan_tumor.obs['cluster04'] = pd.Categorical(pan_tumor.obs['cluster04'], categories=["Tumor stem cells", "Tumor cells"], ordered=True)

indices = pan_tumor.obs.sort_values(['cluster04']).index
pan_tumor = pan_tumor[indices,:]

res_KEGG = gp.gsea(data=pan_tumor.to_df().T, # row -> genes, column-> samples
        gene_sets="KEGG_2021_Human",
        cls=pan_tumor.obs.cluster04,
        permutation_num=1000,
        permutation_type='phenotype',
        outdir=None,
        method='s2n', # signal_to_noise
        threads= 16)

res_KEGG.res2d.to_csv('gsea_tumor_KEGG_new.csv')

