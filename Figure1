pan = {"GHRB20120531_HNSC":GHRB20120531_HNSC, "GSE103322_HNSC":GSE103322_HNSC, "GSE127465_LUSC":GSE127465_LUSC,
       "GSE144236_CSCC":GSE144236_CSCC, "GSE150321_LSCC":GSE150321_LSCC, "GSE160269_ESCC":GSE160269_ESCC,
       "GSE164690_HNSC":GSE164690_HNSC, "GSE168652_CESC":GSE168652_CESC, "huaxi_LUSC":huaxi_LUSC}

pan = sc.concat((pan),join="outer",label="study")

pan.obs_names_make_unique()
pan.obs_names_make_unique()

pan.obs['cancer_type'] = pan.obs['study'].str.split('_', n=1).str[1]

pan.write_h5ad('data/pan_original.h5ad')

import bbknn

sc.pp.normalize_total(pan, target_sum=1e4)

sc.pp.log1p(pan)

sc.pp.highly_variable_genes(pan, min_mean=0.0125, max_mean=5, min_disp=0, n_top_genes=2000)

pan.raw = pan

pan = pan[:, pan.var.highly_variable]

sc.pp.regress_out(pan, ['total_counts', 'pct_counts_mt'])

sc.pp.scale(pan, max_value=10)

sc.tl.pca(pan, svd_solver='arpack')
sc.pl.pca_variance_ratio(pan, log=True)

sc.external.pp.bbknn(pan, batch_key= "sample",n_pcs=10,neighbors_within_batch = 1)

sc.tl.umap(pan)

sc.tl.leiden(pan,resolution = 2)

sc.settings.set_figure_params(dpi=50, dpi_save=300, figsize=(10,10))
sc.pl.umap(pan, color='leiden',legend_loc='on data')

sc.settings.set_figure_params(dpi=50, dpi_save=300, figsize=(10,10))
sc.pl.umap(pan, color='cancer_type',show=False)
plt.savefig("figure/umap_cancer_type.pdf",bbox_inches = 'tight')

sc.settings.set_figure_params(dpi=50, dpi_save=300, figsize=(10,10))
