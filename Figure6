CD8_Immunecells = Immunecells[Immunecells.obs['cluster05'].isin(['CD8 T cells'])]
CD8_Immunecells
CD8_Immunecells.write_h5ad("data/CD8_Immunecells.h5ad")

import bbknn
sc.pp.normalize_total(CD8_Immunecells, target_sum=1e4)
sc.pp.log1p(CD8_Immunecells)
sc.pp.highly_variable_genes(CD8_Immunecells, min_mean=0.0125, max_mean=5, min_disp=0, n_top_genes=2000)
CD8_Immunecells.raw = CD8_Immunecells
CD8_Immunecells = CD8_Immunecells[:, CD8_Immunecells.var.highly_variable]
sc.pp.regress_out(CD8_Immunecells, ['total_counts', 'pct_counts_mt'])
sc.pp.scale(CD8_Immunecells, max_value=10)
sc.tl.pca(CD8_Immunecells, svd_solver='arpack')
sc.pl.pca_variance_ratio(CD8_Immunecells, log=True)
sc.external.pp.bbknn(CD8_Immunecells, batch_key= "sample",n_pcs=50,neighbors_within_batch = 1)
sc.tl.umap(CD8_Immunecells)
sc.tl.leiden(CD8_Immunecells,resolution = 1)
sc.settings.set_figure_params(dpi=50, dpi_save=300, figsize=(10,10))
sc.pl.umap(CD8_Immunecells, color='leiden',legend_loc='on data',show=False)
plt.savefig("figure/umap_leiden_CD8_Immunecells.pdf")

CD8_Immunecells.uns['log1p']["base"] = None
sc.tl.rank_genes_groups(CD8_Immunecells, 'leiden', method='wilcoxon')
CD8_Immunecells.write_h5ad("data/CD8_Immunecells.h5ad")
DEG = sc.get.rank_genes_groups_df(CD8_Immunecells, group = None, pval_cutoff = 0.05, log2fc_min = 0)
DEG.to_csv('DEG_CD8_Immunecells.csv')

